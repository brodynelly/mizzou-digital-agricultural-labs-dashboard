# Copy to .env for local development. Replace all placeholders locally.
DATABASE_HOST=mongo
DATABASE_PORT=27017
DATABASE_COLLECTION=paalab
MONGO_INITDB_DATABASE=paalab
MONGO_INITDB_ROOT_USERNAME=replace-locally
MONGO_INITDB_ROOT_PASSWORD=replace-locally
JWT_SECRET=replace-with-a-long-random-local-secret
MONGO_KEYFILE_PATH=./server/database/sslkey/security.keyFile
SERVER_HOST=paal-backend
SERVER_PORT=5005
